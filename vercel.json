{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/backend/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    { "source": "/backend/:endpoint", "destination": "/api/backend/router.php?endpoint=:endpoint" },
    { "source": "/extend", "destination": "/frontend/extend.html" },
    { "source": "/extend/", "destination": "/frontend/extend.html" },
    { "source": "/", "destination": "/frontend/index.html" }
  ]
}